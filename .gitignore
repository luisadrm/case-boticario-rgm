# --- Dados -------------------------------------------------------------
# A base do case não é versionada (dados de terceiros). Coloque o arquivo em
# data/raw/vendas_sku_semanal.csv antes de rodar. Para versioná-la, apague a
# linha "data/raw/*" abaixo.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Saídas geradas pelos notebooks -------------------------------------
outputs/*
!outputs/.gitkeep

# --- Python / Jupyter ---------------------------------------------------
__pycache__/
build/
*.egg-info/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env

# --- Sistema / editores -------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- Versões antigas (fora do repositório) ------------------------------
notebooks/arquivo/
requirements-arquivo.txt
